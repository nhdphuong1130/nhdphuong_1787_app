# Cấu hình API Endpoint:
# 10.0.2.2 cho Android Emulator kết nối vào Web API máy chủ host (cổng 5000)
BASE_URL=http://10.0.2.2:5000/api/

# Nếu chạy trên thiết bị thật cùng mạng WiFi, đổi thành IP máy tính (VD: http://192.168.1.5:5000/api/)
# Hoặc nếu chạy Tunnel Cloudflare: BASE_URL=https://your-tunnel.trycloudflare.com/api/
